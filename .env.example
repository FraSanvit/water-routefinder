# Copy this file to `.env` (gitignored -- never commit real credentials) and fill in the values
# you need. `.env` is loaded automatically by the Snakemake workflow and by the test suite.
#
# You don't have to use this file at all -- see config/README.md for the alternatives
# (`copernicusmarine login`, a `~/.cdsapirc` file, or real environment variables e.g. in CI
# secrets), which keep credentials out of any file in this repo entirely.

# Copernicus Marine (needed for provider: cmems)
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Copernicus Climate Data Store / ERA5 (needed for provider: era5, unless you have ~/.cdsapirc)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
